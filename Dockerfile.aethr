# Build the frontend first using pnpm build; never ship node_modules or credentials.
FROM nginxinc/nginx-unprivileged:stable-alpine
USER root
ARG OWNER_USERNAME
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
RUN test -n "$OWNER_USERNAME" && echo "$OWNER_USERNAME" | grep -Eq '^[A-Za-z0-9_-]+$' && sed -i "s/OWNER_USERNAME/$OWNER_USERNAME/" /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/
USER 101
EXPOSE 8080
